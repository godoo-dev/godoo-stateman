exports[`stateman CLI characterization > apply with fixture 1`] = `
{
  "code": 1,
  "err": "{"code":"USAGE","message":"Apply takes a reviewed plan, not a fixture"}",
  "out": "",
}
`;

exports[`stateman CLI characterization > apply without journal 1`] = `
{
  "code": 1,
  "err": "{"code":"RECOVERY_JOURNAL_REQUIRED","message":"Apply requires an explicit --journal path"}",
  "out": "",
}
`;

exports[`stateman CLI characterization > connection without export 1`] = `
{
  "code": 1,
  "err": "{"code":"INVALID_CONNECTION","message":"Connection module must export a StateConnection"}",
  "out": "",
}
`;

exports[`stateman CLI characterization > extra positional 1`] = `
{
  "code": 1,
  "err": "{"code":"USAGE","message":"Usage: stateman <load|inspect> <file-or-directory> [--content-root <directory>] [--fixture]\\n       stateman <plan|drift> <file-or-directory> --connection <module> [--options <json>] [--journal <json>] [--out <json>] [--fixture]\\n       stateman apply <reviewed-plan.json> --connection <module> --journal <json>\\n       stateman --help\\n\\nLoads trusted TypeScript/ESM modules with ordinary filesystem/network privileges.\\n--connection explicitly selects a trusted module exporting a StateConnection as default\\nor connection. That module owns credentials/authentication and retains client safety.\\nPlans serialize rendered input and observed target assumptions; apply revalidates them.\\nPlan exits 0; drift exits 0 when converged, 2 for differences; errors/apply failure exit 1.\\nApply requires a durable journal for record creation; retain it across crashes and retries.\\n--fixture reads bounded portable JSON instead of executing resource modules.\\nNo implicit action execution, addon changes, broad live export/import or snapshots."}",
  "out": "",
}
`;

exports[`stateman CLI characterization > help 1`] = `
{
  "code": 0,
  "err": "",
  "out": "Usage: stateman <load|inspect> <file-or-directory> [--content-root <directory>] [--fixture]
       stateman <plan|drift> <file-or-directory> --connection <module> [--options <json>] [--journal <json>] [--out <json>] [--fixture]
       stateman apply <reviewed-plan.json> --connection <module> --journal <json>
       stateman --help

Loads trusted TypeScript/ESM modules with ordinary filesystem/network privileges.
--connection explicitly selects a trusted module exporting a StateConnection as default
or connection. That module owns credentials/authentication and retains client safety.
Plans serialize rendered input and observed target assumptions; apply revalidates them.
Plan exits 0; drift exits 0 when converged, 2 for differences; errors/apply failure exit 1.
Apply requires a durable journal for record creation; retain it across crashes and retries.
--fixture reads bounded portable JSON instead of executing resource modules.
No implicit action execution, addon changes, broad live export/import or snapshots.",
}
`;

exports[`stateman CLI characterization > journal equals out 1`] = `
{
  "code": 1,
  "err": "{"code":"PATH_COLLISION","message":"Journal must have its own path, separate from inputs and output"}",
  "out": "",
}
`;

